# Copy to .env and paste your key. NEVER commit .env — it is gitignored.
#
# Enables real AI intake extraction + recommendation review. Without a key the
# app still runs end to end on the deterministic rule engine.
#
# --- Option A: Groq (fastest — recommended for demos) ------------------------
# Get a key at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b — verified to support forced tool
# calling reliably; llama-3.3-70b-versatile has since been retired by Groq.
EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b

# --- Option B: Google Gemini -------------------------------------------------
# Get a key at https://aistudio.google.com/apikey (it starts with "AIza").
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional. Defaults to gemini-2.0-flash.
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# --- Option C: Anthropic -----------------------------------------------------
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5.
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Force a provider when multiple keys are set: "groq", "gemini", or "anthropic".
EXPO_PUBLIC_AI_PROVIDER=
